rules_version = '2';
// 빈칸차트 계정 저장소 규칙
// - users/{uid}: 누구나 읽을 수 있고(닉네임·전적 표시), 본인만 쓸 수 있다.
// - nicknames/{소문자 닉네임}: 닉네임 선점 문서. 없을 때만 만들 수 있고(= 중복 불가), 주인만 지울 수 있다. 수정은 불가.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'total', 'wins', 'losses', 'games', 'createdAt', 'updatedAt']);
    }
    match /nicknames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.size() >= 2 && name.size() <= 12
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'at']);
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
