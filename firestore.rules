rules_version = '2';
// 빈칸차트 계정 저장소 규칙
// - users/{uid}: 누구나 읽을 수 있고(닉네임·전적 표시), 본인만 쓸 수 있다.
// - nicknames/{소문자 닉네임}: 닉네임 선점 문서. 없을 때만 만들 수 있고(= 중복 불가), 주인만 지울 수 있다. 수정은 불가.
//   admin, gm, 운영자, 관리자 로 시작하는 닉네임은 운영자 계정만 만들 수 있다.
// - notices, warnings, mutes: 공지·경고·채팅 금지. 누구나 읽고, 운영자만 쓴다.
// 공개 저장소에 이메일을 두지 않으려고 운영자 이메일은 OWNER_EMAIL 로 적어 두었다. 콘솔에 게시할 때 실제 이메일로 바꾼다.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == 'OWNER_EMAIL'
        && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'total', 'wins', 'losses', 'games', 'createdAt', 'updatedAt']);
    }
    match /nicknames/{name} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && name.size() >= 2 && name.size() <= 12
        && request.resource.data.keys().hasOnly(['uid', 'nick', 'at'])
        && (!name.matches('^(admin|gm|운영자|관리자|게스트|손님|guest).*')
            || (isOwner() && !name.matches('^(게스트|손님|guest).*')));
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /notices/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
    match /warnings/{id} {
      allow read: if true;
      allow create, delete: if isOwner();
    }
    match /mutes/{id} {
      allow read: if true;
      allow write: if isOwner();
    }
  }
}
